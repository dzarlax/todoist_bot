# Todoist Telegram Bot + MCP Server — Environment Variables

# --- required tokens ---

# Telegram Bot Token — get it from @BotFather
TELEGRAM_TOKEN=your_telegram_token_here

# Todoist API Token — https://todoist.com/app/settings/integrations/developer
TODOIST_TOKEN=your_todoist_token_here

# --- MCP server auth ---

# X-API-Key required on MCP /todoist calls. Empty = no auth (dev only).
API_KEY=change-me

# HTTP port for /health and /todoist (default 3000)
PORT=3000

# --- bot behaviour ---

# Seconds to buffer messages before creating a task (default 5)
TIMER=5

# "true" to set every new task's due date to today
AUTO_ADD_DUE_DATE=true

# --- access control ---

# Admin Telegram username (with or without '@'). Grants access to /list.
# BOT_ADMIN=@dzarlax

# Extra whitelisted usernames outside PROJECT_USERS_* mappings, comma-separated.
# ALLOWED_USERNAMES=@someuser

# Project → user mapping (@ entries are auto-whitelisted).
# Multiple entries supported, project name must match Todoist project exactly.
PROJECT_USERS_Inbox="@user1"
PROJECT_USERS_Family="@user2,@user3"
