# Todoist Telegram Bot - Environment Variables

# Telegram Bot Token (required)
# Get it from @BotFather on Telegram
TELEGRAM_TOKEN=your_telegram_token_here

# Todoist API Token (required)
# Get it from https://todoist.com/app/settings/integrations/developer
TODOIST_TOKEN=your_todoist_token_here

# Message buffer timer in seconds (default: 5)
TIMER=5

# Automatically add due date to today (default: false)
AUTO_ADD_DUE_DATE=true

# Logging level: error, warn, info, debug (default: info)
LOG_LEVEL=debug

# Health check server port (default: 3000)
PORT=3000

# Node environment: development, production (default: development)
NODE_ENV=development

# Retry configuration
MAX_RETRIES=3
RETRY_DELAY=1000

# Bot administrator username (optional, @ is optional)
# Admin has access to management commands: /list, etc.
# BOT_ADMIN=@dzarlax

# Extra allowed Telegram usernames beyond those in PROJECT_USERS_* mappings (optional)
# Users from PROJECT_USERS_* are whitelisted automatically — add here anyone without a project
# ALLOWED_USERNAMES=@someuser

# Project to user mappings
# Format: PROJECT_USERS_PROJECTNAME="@user1,@user2,@user3"
PROJECT_USERS_Datalens="@user1,@user2"
PROJECT_USERS_Family="@user3"
PROJECT_USERS_Inbox="@user4"
